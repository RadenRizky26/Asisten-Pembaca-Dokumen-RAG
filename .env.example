# ===== ENV UNTUK VERCEL (set di Vercel Dashboard > Settings > Environment Variables) =====

# Google Gemini API Key (untuk LLM chat & embeddings)
GOOGLE_API_KEY="masukkan_api_key_kamu_di_sini"

# JWT Secret (untuk autentikasi user)
JWT_SECRET="ganti_dengan_secret_key_acak_yang_aman"

# Supabase (database + storage + pgvector)
SUPABASE_URL="https://proyek-kamu.supabase.co"
SUPABASE_KEY="service_role_key_kamu"
